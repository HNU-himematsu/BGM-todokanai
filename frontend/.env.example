# 本地开发使用 Vite proxy 时可以留空。
# 生产环境如果前后端不在同一域名，再填写完整地址。
VITE_API_BASE=
VITE_WS_BASE=

# 二维码实际给参与者访问的地址。
# 例如：VITE_PUBLIC_BASE_URL=https://bgm.example.com
# 如果不填写，则使用当前主持人页面的 origin。
VITE_PUBLIC_BASE_URL=

# 音频对象地址。生产构建指向 OSS，主持人控制台直接播放该地址。
# 本地开发需要走后端流式播放时，把该值改为空。
VITE_AUDIO_URL=https://himematsu.oss-cn-guangzhou.aliyuncs.com/bgm/event-demo.mp3
